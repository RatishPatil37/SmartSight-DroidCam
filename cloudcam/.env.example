# ==========================================================
# SMARTSIGHT CLOUDCAM DAEMON CONFIGURATION
# ==========================================================

# 1. Supabase Project Credentials (from Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Use service_role key for the Pi daemon to allow unrestricted storage upload
SUPABASE_KEY=your-supabase-service-role-key-here
# Storage bucket name in Supabase Storage
SUPABASE_BUCKET=cloudcam_data

# 2. Device Identity
DEVICE_ID=smartsight-alpha-01

# 3. DroidCam Over Tailscale
# Replace with the static Tailscale IP of your Android Phone
DROIDCAM_IP=100.95.120.40
DROIDCAM_PORT=4747

# 4. Local Storage Path for Offline Cache
LOCAL_CAPTURE_DIR=/home/ratish/Desktop/SmartSight/SmartSight/captures
